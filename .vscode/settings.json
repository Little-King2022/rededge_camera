{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "dist_electron": true,
        "dist-electron": true,
        "dist-electron_*": true
    },
    "files.watcherExclude": {
        "**/dist-electron/**": true,
        "**/dist-electron_*/**": true
    },
    "search.exclude": {
        "**/dist-electron/**": true,
        "**/dist-electron_*/**": true
    }
}
