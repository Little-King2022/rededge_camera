# ===================================
# Flask 应用环境变量配置模板
# ===================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改配置值以匹配您的环境
# 3. 生产环境必须修改敏感配置（SECRET_KEY、JWT_SECRET_KEY、数据库密码等）

# -----------------------------------
# 运行环境配置
# -----------------------------------
# 环境类型：development（开发）/ production（生产）
FLASK_ENV=development

# Flask 运行地址和端口
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# -----------------------------------
# 安全配置（生产环境必须修改）
# -----------------------------------
# Flask 密钥（用于会话加密等）
SECRET_KEY=your-super-secret-key-change-in-production

# JWT 密钥（用于 token 签名）
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# -----------------------------------
# 数据库配置
# -----------------------------------
# MySQL 主机地址
MYSQL_HOST=localhost

# MySQL 端口
MYSQL_PORT=3306

# MySQL 用户名
MYSQL_USER=root

# MySQL 密码
MYSQL_PASSWORD=your_mysql_password

# MySQL 数据库名
MYSQL_DATABASE=rededge_admin

# 是否打印 SQL 语句（开发环境可设为 true）
SQLALCHEMY_ECHO=false

# -----------------------------------
# JWT Token 配置
# -----------------------------------
# Access Token 有效期（小时）
JWT_ACCESS_TOKEN_HOURS=2

# Refresh Token 有效期（天）
JWT_REFRESH_TOKEN_DAYS=7

# -----------------------------------
# 文件上传配置
# -----------------------------------
# 上传文件存储路径（留空使用默认 uploads/ 目录）
UPLOAD_FOLDER=

# 最大上传文件大小（字节，默认 500MB）
MAX_CONTENT_LENGTH=524288000

# -----------------------------------
# CORS 跨域配置
# -----------------------------------
# 允许的前端域名（多个用逗号分隔）
# 开发环境示例：http://localhost:5173,http://127.0.0.1:5173
# 生产环境示例：https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------
# API 限流配置
# -----------------------------------
# 限流存储方式（memory:// 或 redis://localhost:6379）
RATELIMIT_STORAGE_URL=memory://

# -----------------------------------
# 授权策略配置
# -----------------------------------
# 试用期天数
TRIAL_DAYS=7

# 在线模式宽限期（天）- 客户端离线后可继续使用的时间
ONLINE_MODE_GRACE_PERIOD_DAYS=3

# -----------------------------------
# 心跳监控配置
# -----------------------------------
# 心跳超时时间（分钟）- 超过此时间未收到心跳视为异常
HEARTBEAT_TIMEOUT_MINUTES=10

# 离线判定时间（分钟）- 超过此时间未收到心跳判定为离线
OFFLINE_THRESHOLD_MINUTES=15
