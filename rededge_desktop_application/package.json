{
  "name": "crop-monitor-desktop",
  "version": "1.2.0",
  "description": "Crop low-altitude monitoring terminal",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "app:dev": "npm run dev",
    "app:build": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "vue",
    "crop-monitor",
    "rededge-camera",
    "remote-sensing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@ant-design/icons-vue": "^7.0.0",
    "ant-design-vue": "^4.1.0",
    "axios": "^1.13.2",
    "electron-store": "^8.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "pinia": "^2.1.0",
    "shpjs": "^6.2.0",
    "three": "^0.182.0",
    "utif": "^3.1.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.rededge.desktop",
    "productName": "RedEdge Monitor",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../python_service/dist/app",
        "to": "python_service/dist/app"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
